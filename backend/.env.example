# Configurações do Servidor
PORT=3001
# BASE_URL — usado pelo agente e links. Ex: dev https://dev.luminoustelecom.com.br | prod https://backnet.app
BASE_URL=http://localhost:3001

# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=backnet
DB_USER=backnet
DB_PASSWORD=

# Configurações de Autenticação
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Configurações de CORS — origens confiáveis separadas por vírgula
# Em produção, definir as URLs reais do frontend. Em dev, deixar vazio para aceitar tudo.
# Para app iOS (Capacitor): incluir https://localhost
# Ex: ALLOWED_ORIGINS=https://app.empresa.com,https://localhost
ALLOWED_ORIGINS=

# Configurações de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Proteção DDoS camada 7 (middleware): timeout padrão por requisição (ms); análise RPKI+RIS usa limite próprio maior
# DDOS_MAX_PROCESSING_TIME=15000
# DDOS_RPKI_ROA_ANALYZE_MAX_MS=600000

ENABLE_METRICS=false

# RPKI — User-Agent opcional nas chamadas HTTP Up/Down ao parent (alguns provedores/WAF são sensíveis ao cliente)
# RPKI_HTTP_USER_AGENT=Mozilla/5.0 (compatible; RPKI)

GITHUB_REPO=
GITHUB_TOKEN=

# Configurações do Elasticsearch (Auditoria)
ELASTICSEARCH_NODE=http://localhost:9200
# Data streams (logs-backnet-*) são criados pelo script único (após build, sem ts-node em produção):
# npm run build && npm run setup:elasticsearch
# Em desenvolvimento sem compilar: npm run setup:elasticsearch:dev
# A variável abaixo era usada pelo índice monolítico legado e não é mais lida pela aplicação.
# ELASTICSEARCH_INDEX_NAME=backnet-auditoria
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Redis sem senha: redis://localhost:6379 | com senha: redis://:senha@localhost:6379
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=  # opcional, se o Redis exigir autenticação

# Scheduler: concorrência máxima da fila de rotinas (default: 2)
# Evita saturação quando várias rotinas disparam no mesmo horário
# SCHEDULER_QUEUE_CONCURRENCY=2

# Fila de backup SSH (BullMQ): jobs por equipamento; default 2
# SSH_BACKUP_QUEUE_CONCURRENCY=2
# Timeout do comando /export no MikroTik (ms); default 120000
# SSH_BACKUP_COMMAND_TIMEOUT_MS=120000

# SSH Manager
# Agente BackNet: se não definido, usa :dev ou :prod conforme BASE_URL (dev.luminoustelecom=dev)
# BACKNET_AGENT_IMAGE=midia181/backnet-tunnel:prod

# OBRIGATÓRIO para SSH Manager e proxy via agente — senhas criptografadas com AES-256
# Gere com: openssl rand -base64 32 | head -c 32
SSH_ENCRYPTION_KEY=                    # string de exatamente 32 caracteres
SSH_POOL_MAX_CONNECTIONS=10            # máximo de conexões simultâneas por gateway
SSH_IDLE_TIMEOUT_MS=300000             # tempo de inatividade antes de fechar conexão (5 min)
SSH_HEALTH_CHECK_INTERVAL_MS=30000    # intervalo entre health checks dos gateways (30s)
SSH_RECONNECT_MAX_ATTEMPTS=5          # tentativas de reconexão com backoff exponencial
# Diagnóstico: logs de latência entrada/eco no terminal SSH (evite deixar ligado em produção)
# SSH_TERMINAL_LATENCY_DEBUG=1

# Extração de domínios em PDF (extrair-dominios.py). Em Debian com PEP 668, aponte para o Python do venv onde instalou pymupdf.
# Ex.: PDF_EXTRACT_PYTHON=/opt/backnet/backend/.venv/bin/python
# PDF_EXTRACT_PYTHON=

# WHOIS de IP (Blockdomi): bootstrap RDAP global (RFC 9224). Redireciona ao RIR correto; sem API key.
# RDAP_IP_BOOTSTRAP_BASE_URL=https://rdap-bootstrap.arin.net/bootstrap/ip

# RPKI — sugestões de ROA estilo Krill (dumps RIPE RIS / BGP). Por padrão: ativo com as mesmas URLs do Krill (config); download pode ser pesado.
# Desligar explicitamente:
# RPKI_BGP_RISWHOIS_ENABLED=false
# Sobrescrever URLs (opcional):
# RPKI_BGP_RISWHOIS_IPV4_URI=https://www.ris.ripe.net/dumps/riswhoisdump.IPv4.gz
# RPKI_BGP_RISWHOIS_IPV6_URI=https://www.ris.ripe.net/dumps/riswhoisdump.IPv6.gz
# RPKI_BGP_RISWHOIS_TIMEOUT_MS=180000
# Cache em RAM entre análises (como Krill mantém dataset entre cliques); default 3600000 ms (1 h)
# Enquanto o dump estiver em cache, a análise reutiliza também a lista de anúncios já filtrada pela CA (evita varrer milhões de linhas a cada clique).
# RPKI_BGP_RISWHOIS_CACHE_TTL_MS=3600000
# Com REDIS_URL definido (ver acima): grava também no Redis (~gzip) para reidratar após restart sem baixar o dump de novo. Desligar: RPKI_BGP_RISWHOIS_REDIS_CACHE=false
# RPKI_BGP_RISWHOIS_REDIS_CACHE=
# RPKI_BGP_RISWHOIS_MAX_LINES=8000000
# RPKI_BGP_RISWHOIS_MAX_ANNOUNCEMENTS=5000
# RPKI_BGP_RISWHOIS_MAX_SUGGESTIONS=250
