/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model agent_agents {
  empresa_id           Int?
  name                 String                @db.VarChar(100)
  token_hash           String                @unique(map: "token_hash") @db.VarChar(64)
  token_hint           String?               @db.VarChar(12)
  description          String?               @db.VarChar(500)
  is_active            Boolean               @default(true)
  last_seen_at         DateTime?             @db.DateTime(0)
  version              String?               @db.VarChar(50)
  hostname             String?               @db.VarChar(255)
  os_info              String?               @db.VarChar(255)
  ip_address           String?               @db.VarChar(45)
  created_at           DateTime              @default(now()) @db.DateTime(0)
  updated_at           DateTime              @default(now()) @db.DateTime(0)
  cliente_id           Int?
  id                   Int                   @id @default(autoincrement())
  connection_mode      String                @default("socket") @db.VarChar(20)
  mikrotik_host        String?               @db.VarChar(255)
  mikrotik_api_port    Int?
  mikrotik_api_tls     Boolean               @default(false)
  mikrotik_username    String?               @db.VarChar(64)
  mikrotik_password    String?               @db.Text
  wg_listen_port       Int?
  wg_lan_cidrs         String?               @db.VarChar(500)
  wg_interface_name    String?               @db.VarChar(15)
  wg_our_public_key    String?               @db.VarChar(64)
  wg_our_private_key   String?               @db.Text
  wg_peer_public_key   String?               @db.VarChar(64)
  wg_address_ours      String?               @db.VarChar(45)
  wg_address_peer      String?               @db.VarChar(45)
  wg_status            String                @default("idle") @db.VarChar(20)
  wg_last_handshake_at DateTime?             @db.DateTime(0)
  wg_last_error        String?               @db.VarChar(500)
  clientes             clientes?             @relation(fields: [cliente_id], references: [id], map: "adm_agents_cliente_id_foreign_idx")
  sistema_tenants      sistema_tenants?      @relation(fields: [empresa_id], references: [id], map: "agent_agents_ibfk_1")
  ssh_manager_devices  ssh_manager_devices[]

  @@index([cliente_id], map: "adm_agents_cliente_id")
  @@index([empresa_id], map: "adm_agents_empresa_id")
  @@index([is_active], map: "adm_agents_is_active")
  @@index([token_hash], map: "adm_agents_token_hash")
}

