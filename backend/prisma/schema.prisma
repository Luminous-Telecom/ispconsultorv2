/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ssh_manager_device_backups {
  id                  Int                 @id @default(autoincrement())
  file_name           String              @db.VarChar(255)
  size_bytes          BigInt
  created_at          DateTime            @default(now()) @db.DateTime(0)
  started_at          DateTime            @db.DateTime(0)
  finished_at         DateTime            @db.DateTime(0)
  ssh_device_id       Int
  ssh_manager_devices ssh_manager_devices @relation(fields: [ssh_device_id], references: [id], onDelete: Cascade, map: "adm_ssh_device_backups_device_fk")

  @@unique([ssh_device_id, file_name], map: "adm_ssh_device_backups_device_file_unique")
  @@index([created_at], map: "adm_ssh_device_backups_created_at")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ssh_manager_devices {
  empresa_id                       Int?
  name                             String                             @db.VarChar(100)
  host                             String                             @db.VarChar(255)
  port                             Int                                @default(22)
  username                         String                             @db.VarChar(100)
  password                         String                             @db.VarChar(500)
  private_key                      String?                            @db.Text
  device_type                      ssh_manager_devices_device_type    @default(mikrotik)
  description                      String?                            @db.VarChar(500)
  is_active                        Boolean                            @default(true)
  tags                             String?                            @db.LongText
  created_at                       DateTime                           @default(now()) @db.DateTime(0)
  updated_at                       DateTime                           @default(now()) @db.DateTime(0)
  cliente_id                       Int?
  backup_enabled                   Boolean                            @default(false)
  agent_id                         Int?
  id                               Int                                @id @default(autoincrement())
  ssh_manager_device_backups       ssh_manager_device_backups[]
  agent_agents                     agent_agents?                      @relation(fields: [agent_id], references: [id], map: "adm_ssh_devices_agent_fk")
  clientes                         clientes?                          @relation(fields: [cliente_id], references: [id], map: "adm_ssh_devices_cliente_id_foreign_idx")
  sistema_tenants                  sistema_tenants?                   @relation(fields: [empresa_id], references: [id], map: "ssh_manager_devices_ibfk_1")

  @@index([agent_id], map: "adm_ssh_devices_agent_fk")
  @@index([backup_enabled], map: "adm_ssh_devices_backup_enabled")
  @@index([cliente_id], map: "adm_ssh_devices_cliente_id")
  @@index([device_type], map: "adm_ssh_devices_device_type")
  @@index([empresa_id], map: "adm_ssh_devices_empresa_id")
  @@index([is_active], map: "adm_ssh_devices_is_active")
}

