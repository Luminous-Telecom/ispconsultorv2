# Configurações do Servidor
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001

# Frontend (opcional - se não definido, o backend serve o frontend integrado)
# FRONTEND_URL=http://localhost:3000

# CORS (opcional - se não definido, aceita requisições da mesma origem)
# CORS_ORIGIN=http://localhost

# Configuração da API para o frontend (obrigatório quando frontend está integrado)
# ⚠️ IMPORTANTE: Em produção, SEMPRE use URL relativa: /api
# O backend gera /config.js dinamicamente com este valor para o frontend usar
# O frontend sempre prioriza window.__APP_CONFIG__ sobre process.env
# 
# Desenvolvimento local (se frontend separado): http://localhost:3001/api
# Produção (com Nginx): /api
REACT_APP_API_URL=/api
REACT_APP_API_TIMEOUT=10000
REACT_APP_API_RETRY_ATTEMPTS=3
REACT_APP_API_RETRY_DELAY=1000

# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=backnet
DB_USER=backnet
DB_PASSWORD=troque-esta-senha
DB_DIALECT=mysql

# Configurações de Autenticação
JWT_SECRET=z4ndCAsgQsXXIDaWmkPTWsZeMP9n7YSV
JWT_EXPIRES_IN=24h

# Configurações de Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Configurações de Rate Limiting
# ⚠️ Rate limiting está DESABILITADO por padrão para evitar bloqueios durante uso normal
# Para habilitar, defina ENABLE_RATE_LIMIT=true
# O rate limiting pode causar problemas quando o sistema faz muitas requisições simultâneas
# ENABLE_RATE_LIMIT=false
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100000