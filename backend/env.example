# Configurações do Servidor
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=backnet
DB_USER=backnet
DB_PASSWORD=vantora
DB_DIALECT=mysql

# Configurações de Autenticação
JWT_SECRET=seu_jwt_secret_muito_seguro_aqui
JWT_EXPIRES_IN=24h

# Configurações de Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Configurações de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configurações do WhatsApp Flow
# Chave privada RSA 2048 bits para descriptografar chaves AES do WhatsApp Flow
# IMPORTANTE: WhatsApp Business API requer RSA 2048 bits
# Formato: -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Ou deixe vazio para carregar do arquivo .rsa_private_key.pem
WHATSAPP_FLOW_RSA_PRIVATE_KEY=
