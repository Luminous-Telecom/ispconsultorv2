# Configurações do Servidor
PORT=3001
NODE_ENV=development

# ⚠️ IMPORTANTE: URLs não são mais necessárias no .env
# O backend detecta automaticamente a partir das requisições
# Links são sempre relativos e funcionam em qualquer ambiente

# Configuração da API para o frontend (valores padrão hardcoded)
# O backend gera /config.js automaticamente com valores padrão
# Não precisa configurar REACT_APP_API_URL - sempre será /api

# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=backnet
DB_USER=backnet
DB_PASSWORD=troque-esta-senha
DB_DIALECT=mysql

# Configurações de Autenticação
JWT_SECRET=z4ndCAsgQsXXIDaWmkPTWsZeMP9n7YSV
JWT_EXPIRES_IN=24h

# Configurações de Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Configurações de Rate Limiting
# ⚠️ Rate limiting está DESABILITADO por padrão para evitar bloqueios durante uso normal
# Para habilitar, defina ENABLE_RATE_LIMIT=true
# O rate limiting pode causar problemas quando o sistema faz muitas requisições simultâneas
# ENABLE_RATE_LIMIT=false
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100000


# Configurações do Elasticsearch (Auditoria)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX_NAME=backnet-auditoria
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=Tn6kBn6vAHPEmn9xCxOiG6vwFH2elkQV