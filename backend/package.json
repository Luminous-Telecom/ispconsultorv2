{
  "name": "BackNet-backend",
  "version": "1.0.0-9bc3b397",
  "description": "Backend API para ERP Assessoria",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node --watch src --ext ts,json src/index.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' tsc && cp -r src/templates dist/ && cp -r images dist/",
    "start": "node dist/index.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.5",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "canvas": "^3.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf": "^3.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "helmet": "^7.1.0",
    "html-pdf-node": "^1.0.8",
    "javascript-obfuscator": "^4.1.0",
    "joi": "^17.11.0",
    "jsbarcode": "^3.12.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.9",
    "pdfkit": "^0.17.2",
    "pdfkit-table": "^0.1.99",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.27.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.35.2",
    "sqlite3": "^5.1.7",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/csrf": "^1.3.2",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.10.4",
    "@types/nodemailer": "^7.0.2",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
