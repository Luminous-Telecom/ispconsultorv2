# ⚠️ IMPORTANTE: Este arquivo é usado APENAS em desenvolvimento local (npm run dev)
# Em produção, as configurações vêm do backend via window.__APP_CONFIG__ (arquivo /config.js)

# Porta do servidor (usado pelo server.js em produção)
PORT=3000

# Desabilitar abertura automática do navegador
BROWSER=none

# URL do backend (usado pelo server.js para proxy em produção e setupProxy.js em desenvolvimento)
BACKEND_URL=http://localhost:3001

# Configurações da API
# ⚠️ ATENÇÃO: Use URL completa APENAS em desenvolvimento local
# Em produção, o backend gera /config.js com REACT_APP_API_URL=/api (relativo)
# O frontend sempre prioriza window.__APP_CONFIG__ sobre process.env
REACT_APP_API_URL=http://localhost:3001/api

# Opcional: ajustar comportamento de timeouts/retries (valores em ms)
# REACT_APP_API_TIMEOUT=10000
# REACT_APP_API_RETRY_ATTEMPTS=3
# REACT_APP_API_RETRY_DELAY=1000

# NOTA: Em produção, essas configurações vêm do backend via window.__APP_CONFIG__
# O backend lê REACT_APP_API_URL do seu .env e gera /config.js dinamicamente
# NUNCA faça build com URLs hardcoded - sempre use /api em produção

