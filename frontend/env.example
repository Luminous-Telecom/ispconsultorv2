# ⚠️ IMPORTANTE: Este arquivo é usado APENAS para dados sensíveis
# URLs e configurações de conexão são hardcoded no código ou vêm do backend via /config.js

# Desabilitar abertura automática do navegador (opcional)
BROWSER=none

# Porta do servidor frontend (opcional, padrão: 3000)
# PORT=3000

# URL do backend para proxy em produção (opcional, padrão: http://localhost:3001)
# Só necessário se o backend estiver em outro servidor
# BACKEND_URL=http://localhost:3001

# NOTA: 
# - Em desenvolvimento, o proxy usa localhost:3001 por padrão
# - Em produção, as configurações vêm do backend via window.__APP_CONFIG__ (arquivo /config.js)
# - URLs da API são sempre relativas (/api) e não precisam de configuração
# - Use este arquivo APENAS para dados sensíveis (se houver)

