# Porta do servidor de desenvolvimento (apenas para npm run dev)
PORT=3000

# Configurações da API
# URL do backend - obrigatória para desenvolvimento
REACT_APP_API_URL=http://localhost:3001/api

# Opcional: ajustar comportamento de timeouts/retries (valores em ms)
# REACT_APP_API_TIMEOUT=10000
# REACT_APP_API_RETRY_ATTEMPTS=3
# REACT_APP_API_RETRY_DELAY=1000

# NOTA: Em produção, essas configurações vêm do backend via window.__APP_CONFIG__
# Este arquivo é usado apenas quando roda npm run dev (desenvolvimento separado)

