{
  "name": "backnet-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.1",
    "@tinymce/tinymce-react": "^6.3.0",
    "@types/lodash": "^4.17.21",
    "@types/node": "^16.18.126",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.18.1",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.13.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "http-proxy-middleware": "^2.0.9",
    "lodash": "^4.17.21",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.66.1",
    "react-router-dom": "^7.18.0",
    "react-scripts": "5.0.1",
    "socket.io-client": "^4.8.3",
    "tinymce": "^7.9.3",
    "tinymce-i18n": "^25.11.17",
    "typescript": "^4.9.5",
    "viewerjs": "^1.11.7",
    "zod": "^4.1.12"
  },
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 BROWSER=none craco start",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 BROWSER=none craco start",
    "build": "GENERATE_SOURCEMAP=false NODE_OPTIONS='--max-old-space-size=4096' craco build",
    "build:ios": "npm run build && npx cap sync ios",
    "build:android": "npm run build && npx cap sync android",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "test": "craco test",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "src/utils/sshTerminalLatencyDebug.ts",
          "src/components/modals/ssh-manager/SshTerminalModal.tsx",
          "src/components/modals/agent/AgentTerminalModal.tsx"
        ],
        "rules": {
          "no-console": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@craco/craco": "^7.1.0",
    "@types/bootstrap": "^5.2.10",
    "@types/d3": "^7.4.3",
    "cross-env": "^10.1.0",
    "sass": "^1.97.2"
  },
  "overrides": {
    "@tootallnate/once": "^2.0.1",
    "js-yaml": "^4.1.1",
    "nth-check": "^2.1.1",
    "postcss": "^8.5.15",
    "serialize-javascript": "^7.0.5",
    "tar": "^7.5.16",
    "underscore": "^1.13.8",
    "uuid": "^11.1.1",
    "webpack-dev-server": "^5.2.5",
    "ws": "^8.18.3",
    "react-scripts": {
      "webpack-dev-server": "^5.2.5"
    },
    "@pmmmwh/react-refresh-webpack-plugin": {
      "webpack-dev-server": "^5.2.5"
    }
  }
}
