{
  "extends": ["react-app"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "./tsconfig.json",
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    // 1. Desabilitar no-unused-vars padrão porque @typescript-eslint/no-unused-vars já cobre
    "no-unused-vars": "off",
    "no-console": "warn", // Alertar sobre console.logs (não bloquear, mas avisar)
    
    // 2. Uso explícito de 'any' (muito perigoso, o principal alvo)
    "@typescript-eslint/no-explicit-any": "error",
    
    // 3. Variáveis TS não usadas (ajustado para ignorar _variáveis)
    "@typescript-eslint/no-unused-vars": [
      "error", 
      { 
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    
    // 4. Hook Deps incompletas (erro clássico do React, deve ser 'error' para ser seguro)
    "react-hooks/exhaustive-deps": "error",
    
    // 5. Convenções de nomenclatura
    "@typescript-eslint/naming-convention": [
      "warn",
      {
        // Interfaces e Types em PascalCase
        "selector": ["interface", "typeAlias"],
        "format": ["PascalCase"]
      },
      {
        // Classes em PascalCase
        "selector": "class",
        "format": ["PascalCase"]
      },
      {
        // Variáveis e funções em camelCase
        "selector": ["variable", "function", "parameter"],
        "format": ["camelCase", "PascalCase", "UPPER_CASE"],
        "filter": {
          "regex": "^(handle|on|is|has|should|can|get|set|validate|format)",
          "match": false
        }
      },
      {
        // Handlers e callbacks com prefixos específicos
        "selector": ["variable", "function"],
        "modifiers": ["exported"],
        "format": ["camelCase", "PascalCase"]
      },
      {
        // Constantes em UPPER_SNAKE_CASE
        "selector": "variable",
        "modifiers": ["const"],
        "types": ["boolean", "string", "number"],
        "format": ["UPPER_CASE", "camelCase", "PascalCase"]
      },
      {
        // Componentes React em PascalCase
        "selector": "variable",
        "types": ["function"],
        "format": ["PascalCase", "camelCase"]
      }
    ]
  }
}