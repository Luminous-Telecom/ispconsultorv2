{
  "name": "BackNet-react",
  "version": "1.0.0",
  "description": "Sistema ERP para assessoria técnica em provedores de internet - React + TypeScript",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "dev:pm2": "pm2 start ecosystem.config.js",
    "dev:pm2:stop": "pm2 stop ecosystem.config.js",
    "dev:pm2:restart": "pm2 restart ecosystem.config.js",
    "dev:pm2:logs": "pm2 logs",
    "dev:pm2:monit": "pm2 monit",
    "dev:pm2:delete": "pm2 delete ecosystem.config.js",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "docker:frontend": "docker compose up -d --build frontend"
  },
  "keywords": [
    "erp",
    "assessoria",
    "react",
    "typescript",
    "nodejs"
  ],
  "author": "Lucas",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "pm2": "^6.0.13"
  }
}
